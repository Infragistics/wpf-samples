                  "uniqueItems": false,
                  "items": {
                    "type": "object",
                    "properties": {
                      "NameEN": { "type": "string" },
                      "NameJP": { "type": "string" },
                      "DescriptionEN": { "type": "string" },
                      "DescriptionJP": { "type": "string" },
                      "Status": {
                        "type": "string",
                        "enum": [
                          "NEW",
                          "OLD",
                          "PREVIEW",
                          "UPDATED"
                        ]
                      },
                      "Version": { "type": "number", "minimum": 8, "maximum": 50,  "multipleOf": 0.1 },
                      "Assembly": { "type": "string", "pattern": "^[I][G][a-zA-Z]*$" },
                      "Path": { "type": "string", "pattern": "^[\\/]IG[a-zA-Z0-9._\\/]*\\.xaml$" }
                    },
                    "required": [
                      "Assembly",
                      "DescriptionEN",
                      "DescriptionJP",
                      "NameEN",
                      "NameJP",
