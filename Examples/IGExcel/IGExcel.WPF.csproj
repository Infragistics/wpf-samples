  <ItemGroup>
    <EmbeddedResource Include="Resources\testPassword.xls" />
    <EmbeddedResource Include="Resources\testPassword.xlsx" />
    <EmbeddedResource Include="Resources\testPassword_ja.xls" />
    <EmbeddedResource Include="Resources\testPassword_ja.xlsx" />
  </ItemGroup>
</Project>