    <EmbeddedResource Include="Resources\test.xls" />
    <EmbeddedResource Include="Resources\test.xlsx" />
    <EmbeddedResource Include="Resources\test_ja.xls" />
    <EmbeddedResource Include="Resources\test_ja.xlsx" />
  </ItemGroup>
  <ItemGroup>
