<Project>
  <PropertyGroup>
    <!-- Silence vulnerability source index warnings from private feeds during restore on newer SDKs -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <!-- Avoid failing restores when a configured source is temporarily unavailable -->
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <!-- Limit vulnerability audit to installed packages; or set to none if needed -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>
</Project>
