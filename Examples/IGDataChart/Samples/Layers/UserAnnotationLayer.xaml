<igFramework:SampleContainer x:Class="IGDataChart.Samples.Layers.UserAnnotationLayer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:igFramework="clr-namespace:Infragistics.Samples.Framework;assembly=Infragistics.Samples.Shared"
        xmlns:ig="http://schemas.infragistics.com/xaml"
        xmlns:local="clr-namespace:IGDataChart.Models"
        mc:Ignorable="d"
        Title="UserAnnotationLayer">
    <igFramework:SampleContainer.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- this loads IG styles for MS controls -->
                <ResourceDictionary Source="/IGDataChart;component/Assets/Global.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </igFramework:SampleContainer.Resources>
    <Grid x:Name="LayoutRoot" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.DataContext>
            <local:StockTeslaData />
        </Grid.DataContext>

        <ig:XamToolbar Target="{Binding ElementName=Chart}"/>

        <ig:XamDataChart x:Name="Chart" Grid.Row="1" UserAnnotationInformationRequested="Chart_UserAnnotationInformationRequested"
                   IsHorizontalZoomEnabled="True" UserAnnotationToolTipContentUpdating="Chart_UserAnnotationToolTipContentUpdating"
                   IsVerticalZoomEnabled="True"  
                   Brushes="green red"
                   Outlines="green red">
            <ig:XamDataChart.Axes>

                <ig:NumericYAxis x:Name="yAxisLeft" MinimumValue="0" MaximumValue="550" />

                <ig:CategoryXAxis x:Name="xAxis" ItemsSource="{Binding}" Label="{}{Date}" />

            </ig:XamDataChart.Axes>

            <ig:XamDataChart.Series>
                <ig:FinancialPriceSeries x:Name="Series1" Title="Tesla" 
                                         CloseMemberPath="Close" 
                                         OpenMemberPath="Open" 
                                         HighMemberPath="High" 
                                         LowMemberPath="Low" 
                                         DisplayType="Candlestick"
                                         ShowDefaultTooltip="False" 
                                         ItemsSource="{Binding}"
                                         XAxis="{Binding ElementName=xAxis}"
                                         YAxis="{Binding ElementName=yAxisLeft}" >
                </ig:FinancialPriceSeries>

            </ig:XamDataChart.Series>
        </ig:XamDataChart>
    </Grid>
</igFramework:SampleContainer>
