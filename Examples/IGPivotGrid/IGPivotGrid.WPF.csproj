<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>IGPivotGrid</RootNamespace>
    <AssemblyName>IGPivotGrid</AssemblyName>
    <SccProjectName>SAK</SccProjectName>
    <SccLocalPath>SAK</SccLocalPath>
    <SccAuxPath>SAK</SccAuxPath>
    <SccProvider>SAK</SccProvider>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>..\Output\</OutputPath>
    <BaseIntermediateOutputPath>obj\WPF\</BaseIntermediateOutputPath>
    <DefineConstants>TRACE;DEBUG;WPF</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>..\Output\</OutputPath>
    <BaseIntermediateOutputPath>obj\WPF\</BaseIntermediateOutputPath>
    <DefineConstants>TRACE;WPF</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Infragistics.WPF.Charts.Olap.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.Charts.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.DataManager.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.DataTree.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.DataVisualization.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.Documents.Core.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.DragDrop.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.Excel.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.Olap.Adomd.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.Olap.Excel.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.Olap.FlatData.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.Olap.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.Olap.Xmla.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.PivotDataSlicer.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.PivotGrid.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.Reporting.Trial" Version="25.1.117" />
  </ItemGroup>
  <ItemGroup>
    <AppDesigner Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\EN\DataToAnalyze.xls" />
    <Resource Include="Assets\JA\DataToAnalyze.xls" />
