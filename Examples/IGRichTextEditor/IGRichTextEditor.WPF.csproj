    <PackageReference Include="Infragistics.WPF.RichTextDocument.Rtf.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.RichTextDocument.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.RichTextDocument.Word.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.RichTextEditor.Trial" Version="25.1.117" />
    <PackageReference Include="Infragistics.WPF.Undo.Trial" Version="25.1.117" />
  </ItemGroup>
  <ItemGroup>
