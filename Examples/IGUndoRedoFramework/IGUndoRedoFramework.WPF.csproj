<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>IGUndoRedoFramework</RootNamespace>
    <AssemblyName>IGUndoRedoFramework</AssemblyName>
    <SccProjectName>SAK</SccProjectName>
    <SccLocalPath>SAK</SccLocalPath>
    <SccAuxPath>SAK</SccAuxPath>
    <SccProvider>SAK</SccProvider>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>..\Output\</OutputPath>
    <DefineConstants>DEBUG;TRACE;WPF</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <OutputPath>..\Output\</OutputPath>
    <DefineConstants>DEBUG;TRACE;WPF</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>..\Output\</OutputPath>
    <DefineConstants>TRACE;WPF</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutputPath>..\Output\</OutputPath>
    <DefineConstants>TRACE;WPF</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Infragistics.WPF.Calendar.Trial" Version="25.2.24" />
    <PackageReference Include="Infragistics.WPF.DataGrids.Trial" Version="25.2.24" />
    <PackageReference Include="Infragistics.WPF.Editors.Trial" Version="25.2.24" />
    <PackageReference Include="Infragistics.WPF.Menus.Trial" Version="25.2.24" />
    <PackageReference Include="Infragistics.WPF.Ribbon.Trial" Version="25.2.24" />
    <PackageReference Include="Infragistics.WPF.Schedules.Trial" Version="25.2.24" />
    <PackageReference Include="Infragistics.WPF.Undo.Trial" Version="25.2.24" />
  </ItemGroup>
  <ItemGroup>
    <AppDesigner Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Infragistics.Samples.Framework\Infragistics.Samples.Framework.WPF.csproj" />
    <ProjectReference Include="..\Infragistics.Samples.Shared\Infragistics.Samples.Shared.WPF.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Images\Redo16.png" />
    <Resource Include="Images\Redo32.png" />
    <Resource Include="Images\Undo16.png" />
    <Resource Include="Images\Undo32.png" />
    <Resource Include="Images\UserAdd16.png" />
    <Resource Include="Images\UserAdd32.png" />
    <Resource Include="Images\UserDelete16.png" />
    <Resource Include="Images\UserDelete32.png" />
  </ItemGroup>
  <!-- Prevent App.xaml from being treated as ApplicationDefinition in this class library to fix MC1002/BG1003 -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Update="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
</Project>